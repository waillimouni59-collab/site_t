{%- comment -%}
  Couleurs et mise en page réglables depuis l'éditeur (Paramètres du thème).
{%- endcomment -%}
<style>
  :root {
    --c-bg: {{ settings.color_background }};
    --c-text: {{ settings.color_text }};
    --c-text-rgb: {{ settings.color_text.red }}, {{ settings.color_text.green }}, {{ settings.color_text.blue }};
    --c-muted: {{ settings.color_text_muted }};
    --c-border: {{ settings.color_border }};
    --c-surface: {{ settings.color_surface }};
    --c-btn: {{ settings.color_button }};
    --c-btn-text: {{ settings.color_button_text }};
    --c-ann-bg: {{ settings.color_announcement_bg }};
    --c-ann-text: {{ settings.color_announcement_text }};
    --c-sale: {{ settings.color_sale }};
    --page-width: {{ settings.page_width }}px;
    --card-ratio: {{ settings.card_ratio | default: '1 / 1' }};
    --card-fit: {{ settings.card_fit | default: 'contain' }};
    --title-transform: {% if settings.uppercase_titles %}uppercase{% else %}none{% endif %};
    --title-spacing: {% if settings.uppercase_titles %}0.08em{% else %}0{% endif %};
  }
</style>
