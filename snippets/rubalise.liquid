{%- comment -%}
  Séparateur en rubalise rouge et blanche.
  Accepte :
  - text : {String} texte répété sur la bande (facultatif)
  - tilt : {Number} rotation en degrés (facultatif, -1 par défaut)
{%- endcomment -%}
{%- assign tape_tilt = tilt | default: -1 -%}
<div class="rubalise" style="--tilt: {{ tape_tilt }}deg;" aria-hidden="true">
  <div class="rubalise__band">
    {%- if text != blank -%}
      {%- for i in (1..12) -%}
        <span>{{ text | escape }}</span>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>
