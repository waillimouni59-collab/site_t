{%- comment -%}
  Titre de section écrit comme sur une pancarte / un sticker / un mur / une affiche.
  Accepte :
  - title : {String}
  - style : {String} pancarte (défaut), sticker, mur, bitume, affiche
  - tag : {String} balise de titre (h2 par défaut)
  - id : {String} id du titre (facultatif)
{%- endcomment -%}
{%- liquid
  assign title_style = style | default: 'pancarte'
  assign title_tag = tag | default: 'h2'
-%}
<{{ title_tag }} class="sign sign--{{ title_style }}"{% if id %} id="{{ id }}"{% endif %}>
  <span class="sign__text">{{ title | escape }}</span>
</{{ title_tag }}>
