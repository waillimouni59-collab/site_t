{%- comment -%}
  Pastilles des couleurs disponibles (option « Couleur » / « Color »).
  Accepte :
  - product : {Object}
{%- endcomment -%}
{%- for option in product.options_with_values -%}
  {%- assign option_name = option.name | downcase -%}
  {%- if option_name == 'couleur' or option_name == 'color' or option_name == 'colour' or option_name == 'coloris' -%}
    <ul class="swatches" role="list" aria-label="Couleurs disponibles : {{ option.values | join: ', ' | escape }}">
      {%- for value in option.values -%}
        <li class="swatches__item">
          <span class="swatch" style="--swatch: {% render 'color-value', value: value %};" title="{{ value | escape }}"></span>
        </li>
      {%- endfor -%}
    </ul>
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
