{%- comment -%}
  Carte produit : image (2e image au survol), nom, prix, pastilles de couleur.

  Accepte :
  - product : {Object} produit (si absent, carte d'exemple)
  - index : {Number} position dans la grille
  - sizes : {String} attribut sizes des images (facultatif)
{%- endcomment -%}
{%- liquid
  assign position = index | default: 0
  assign img_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign loading = 'lazy'
  if position < 4
    assign loading = 'eager'
  endif
-%}

<article class="card reveal" style="--delay: {{ position | modulo: 4 | times: 60 }}ms;">
  {%- if product != blank -%}
    {%- liquid
      assign front = product.featured_media.preview_image
      assign back = nil
      if settings.card_show_back and product.media.size > 1
        assign back = product.media[1].preview_image
      endif
      assign front_alt = product.featured_media.alt | default: product.title
    -%}
    <a href="{{ product.url }}" class="card__media{% if back != blank %} card__media--has-back{% endif %}" tabindex="-1" aria-hidden="true">
      {%- if front != blank -%}
        {{
          front
          | image_url: width: 1100
          | image_tag:
            class: 'card__img card__img--front',
            widths: '300, 450, 600, 800, 1100',
            sizes: img_sizes,
            loading: loading,
            alt: front_alt
        }}
        {%- if back != blank -%}
          {{
            back
            | image_url: width: 1100
            | image_tag:
              class: 'card__img card__img--back',
              widths: '300, 450, 600, 800, 1100',
              sizes: img_sizes,
              loading: 'lazy',
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'card__img placeholder' }}
      {%- endif -%}
      {%- unless product.available -%}
        <span class="badge">Épuisé</span>
      {%- else -%}
        {%- if product.compare_at_price > product.price -%}
          <span class="badge badge--sale">Promo</span>
        {%- endif -%}
      {%- endunless -%}
    </a>

    <div class="card__info">
      <h3 class="card__title">
        <a href="{{ product.url }}" class="card__link">{{ product.title | escape }}</a>
      </h3>
      {% render 'price', product: product, class: 'card__price' %}
      {%- if settings.card_show_swatches -%}
        {% render 'swatches', product: product %}
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="card__media">
      {%- assign placeholder_index = position | modulo: 2 | plus: 1 -%}
      {{ 'product-apparel-' | append: placeholder_index | placeholder_svg_tag: 'card__img placeholder' }}
    </div>
    <div class="card__info">
      <h3 class="card__title">Nom du produit</h3>
      <p class="price card__price"><span class="price__current">35,00 €</span></p>
    </div>
  {%- endif -%}
</article>
