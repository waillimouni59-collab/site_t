{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": { "type": "title" },
        "price": { "type": "price" },
        "variants": { "type": "variant_picker" },
        "size_guide": { "type": "size_guide", "settings": { "label": "Guide des tailles" } },
        "buy": { "type": "buy_buttons", "settings": { "show_quantity": false, "show_dynamic_checkout": false } },
        "description": {
          "type": "collapsible",
          "settings": { "heading": "Description", "use_description": true, "open": true }
        },
        "care": {
          "type": "collapsible",
          "settings": {
            "heading": "Entretien",
            "use_description": false,
            "content": "<p>Lavage en machine à 30 °C, sur l'envers. Ne pas utiliser de sèche-linge. Ne pas repasser sur l'impression.</p>",
            "open": false
          }
        },
        "shipping": {
          "type": "collapsible",
          "settings": {
            "heading": "Livraison et retours",
            "use_description": false,
            "content": "<p>Livraison offerte en France dès 60 € d'achat. Retours acceptés sous 30 jours, selon nos conditions de retour.</p>",
            "open": false
          }
        },
        "share": { "type": "share", "settings": { "label": "Partager" } }
      },
      "block_order": ["title", "price", "variants", "size_guide", "buy", "description", "care", "shipping", "share"],
      "settings": {}
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": { "title": "Vous aimerez aussi", "products_to_show": 4 }
    }
  },
  "order": ["main", "recommendations"]
}
