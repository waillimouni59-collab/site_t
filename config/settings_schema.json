[
  {
    "name": "theme_info",
    "theme_name": "Essentiel",
    "theme_version": "2.0.0",
    "theme_author": "waillimouni59-collab",
    "theme_documentation_url": "https://github.com/waillimouni59-collab/site_t",
    "theme_support_url": "https://github.com/waillimouni59-collab/site_t/issues"
  },
  {
    "name": "Couleurs",
    "settings": [
      { "type": "color", "id": "color_background", "label": "Fond", "default": "#FFFFFF" },
      { "type": "color", "id": "color_text", "label": "Texte", "default": "#111111" },
      { "type": "color", "id": "color_text_muted", "label": "Texte secondaire (prix, infos)", "default": "#6B6B6B" },
      { "type": "color", "id": "color_border", "label": "Bordures", "default": "#E6E6E6" },
      { "type": "color", "id": "color_surface", "label": "Fond des images produits", "default": "#F5F5F5" },
      { "type": "color", "id": "color_button", "label": "Boutons", "default": "#111111" },
      { "type": "color", "id": "color_button_text", "label": "Texte des boutons", "default": "#FFFFFF" },
      { "type": "color", "id": "color_announcement_bg", "label": "Bandeau d'annonce : fond", "default": "#1F1F1F" },
      { "type": "color", "id": "color_announcement_text", "label": "Bandeau d'annonce : texte", "default": "#FFFFFF" },
      { "type": "color", "id": "color_sale", "label": "Prix promo", "default": "#B3122B" }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Largeur maximale de la page",
        "min": 1000,
        "max": 2000,
        "step": 20,
        "unit": "px",
        "default": 1840
      },
      {
        "type": "checkbox",
        "id": "uppercase_titles",
        "label": "Titres et menu en majuscules",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Apparition douce au scroll",
        "info": "Désactivée automatiquement si le visiteur a demandé moins d'animations.",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 × 32 px, PNG"
      }
    ]
  },
  {
    "name": "Prix",
    "settings": [
      {
        "type": "checkbox",
        "id": "currency_code_enabled",
        "label": "Afficher le code de la devise",
        "info": "Ex. 35,00 € EUR",
        "default": false
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type de panier",
        "options": [
          { "value": "drawer", "label": "Tiroir latéral" },
          { "value": "page", "label": "Page panier" }
        ],
        "default": "drawer"
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Seuil de livraison offerte",
        "info": "0 pour masquer la barre. Pense à créer le tarif gratuit correspondant dans Paramètres > Expédition.",
        "min": 0,
        "max": 300,
        "step": 5,
        "unit": "€",
        "default": 60
      },
      {
        "type": "text",
        "id": "cart_note_offer",
        "label": "Message dans le panier (facultatif)",
        "info": "Ex. une offre en cours"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Afficher la note de commande",
        "default": false
      }
    ]
  },
  {
    "name": "Cartes produits",
    "settings": [
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Format des images",
        "options": [
          { "value": "1 / 1", "label": "Carré" },
          { "value": "4 / 5", "label": "Portrait" },
          { "value": "3 / 4", "label": "Portrait allongé" }
        ],
        "default": "1 / 1"
      },
      {
        "type": "select",
        "id": "card_fit",
        "label": "Cadrage des images",
        "options": [
          { "value": "contain", "label": "Image entière" },
          { "value": "cover", "label": "Remplir le cadre" }
        ],
        "default": "contain"
      },
      {
        "type": "checkbox",
        "id": "card_show_back",
        "label": "Afficher la 2e image au survol",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Afficher les pastilles de couleur",
        "default": true
      },
      {
        "type": "page",
        "id": "size_guide_page",
        "label": "Page « Guide des tailles »",
        "info": "Facultatif. Sinon un tableau standard XS à XXL est affiché."
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram", "info": "https://instagram.com/…" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok", "info": "https://tiktok.com/@…" }
    ]
  }
]
