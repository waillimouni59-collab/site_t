{%- liquid
  assign coll = section.settings.collection
  if coll == blank
    assign coll = collections.all
  endif
  assign limit = section.settings.products_to_show
  assign heading_id = 'Heading-' | append: section.id
-%}

<section class="section" aria-labelledby="{{ heading_id }}">
  <div class="page-width">
    {%- if section.settings.title != blank or section.settings.show_view_all -%}
      <div class="section__head">
        <h2 id="{{ heading_id }}" class="section__title">{{ section.settings.title | escape }}</h2>
        {%- if section.settings.show_view_all and coll.url != blank -%}
          <a href="{{ coll.url }}" class="section__link">{{ section.settings.view_all_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid grid--products grid--cols-{{ section.settings.columns_desktop }}">
      {%- if coll.products.size > 0 -%}
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {% render 'product-card', index: forloop.index0 %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grille de produits",
  "tag": "div",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Nouveautés" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Par défaut : tous les produits." },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Colonnes sur ordinateur",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Lien « Tout voir »", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Texte du lien", "default": "Tout voir" }
  ],
  "presets": [{ "name": "Grille de produits" }]
}
{% endschema %}
