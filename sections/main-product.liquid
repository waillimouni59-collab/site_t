{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign form_id = 'ProductForm-' | append: section.id
-%}

<section
  class="product page-width"
  data-product-section
  data-section-id="{{ section.id }}"
>
  <div class="product__gallery" data-gallery>
    <div class="gallery__main">
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          <div
            class="gallery__slide{% if media.id == featured.id %} is-active{% endif %}"
            data-media-id="{{ media.id }}"
            {% unless media.id == featured.id %}hidden{% endunless %}
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- liquid
                  assign media_alt = media.alt | default: product.title
                  assign media_loading = 'lazy'
                  if media.id == featured.id
                    assign media_loading = 'eager'
                  endif
                -%}
                {{
                  media
                  | image_url: width: 1800
                  | image_tag:
                    class: 'gallery__img',
                    widths: '500, 750, 1000, 1400, 1800',
                    sizes: '(min-width: 990px) 58vw, 100vw',
                    loading: media_loading,
                    alt: media_alt
                }}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, class: 'gallery__img' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag: class: 'gallery__img' }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag: class: 'gallery__img' }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="gallery__slide is-active">
          {{ 'product-apparel-1' | placeholder_svg_tag: 'gallery__img placeholder' }}
        </div>
      {%- endif -%}
    </div>

    {%- if product.media.size > 1 -%}
      <ul class="gallery__thumbs" role="list" aria-label="Images du produit">
        {%- for media in product.media -%}
          <li>
            <button
              type="button"
              class="gallery__thumb{% if media.id == featured.id %} is-active{% endif %}"
              data-media-target="{{ media.id }}"
              aria-label="Voir l'image {{ forloop.index }} : {{ media.alt | default: product.title | escape }}"
              {% if media.id == featured.id %}aria-current="true"{% endif %}
            >
              {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}

        {%- when 'title' -%}
          <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

        {%- when 'price' -%}
          <div class="product__price" data-price-wrapper {{ block.shopify_attributes }}>
            {% render 'price', product: product, variant: current_variant %}
            {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
              <p class="product__tax">
                {%- if cart.taxes_included %}TVA incluse.{% endif %}
                {% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">Frais de livraison</a> calculés lors du paiement.{% endif -%}
              </p>
            {%- endif -%}
          </div>

        {%- when 'variant_picker' -%}
          {%- unless product.has_only_default_variant -%}
            <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign option_name = option.name | downcase
                  assign is_color = false
                  if option_name == 'couleur' or option_name == 'color' or option_name == 'colour' or option_name == 'coloris'
                    assign is_color = true
                  endif
                  assign option_index = forloop.index0
                -%}
                <fieldset class="variant-picker__group">
                  <legend class="variant-picker__legend">
                    {{ option.name | escape }} : <span data-option-selected="{{ option_index }}">{{ option.selected_value | escape }}</span>
                  </legend>
                  <div class="variant-picker__values{% if is_color %} variant-picker__values--color{% endif %}">
                    {%- for value in option.values -%}
                      {%- assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                      <input
                        type="radio"
                        id="Option-{{ input_id }}"
                        name="option-{{ section.id }}-{{ option_index }}"
                        value="{{ value | escape }}"
                        class="variant-picker__input"
                        data-option-index="{{ option_index }}"
                        form="{{ form_id }}-options"
                        {% if option.selected_value == value %}checked{% endif %}
                      >
                      {%- if is_color -%}
                        <label for="Option-{{ input_id }}" class="variant-picker__swatch{% if value.available == false %} is-unavailable{% endif %}" style="--swatch: {% render 'color-value', value: value %};" title="{{ value | escape }}">
                          <span class="visually-hidden">{{ value | escape }}{% if value.available == false %} (épuisé){% endif %}</span>
                        </label>
                      {%- else -%}
                        <label for="Option-{{ input_id }}" class="variant-picker__pill{% if value.available == false %} is-unavailable{% endif %}">
                          {{- value | escape -}}
                          {%- if value.available == false %}<span class="visually-hidden"> (épuisé)</span>{% endif -%}
                        </label>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

        {%- when 'size_guide' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'size-guide', label: block.settings.label %}
          </div>

        {%- when 'buy_buttons' -%}
          <div class="product-form" {{ block.shopify_attributes }}>
            {%- form 'product', product, id: form_id, class: 'product-form__form', novalidate: 'novalidate', data-product-form: '' -%}
              <label class="variant-select-fallback">
                <span class="visually-hidden">Variante</span>
                <select name="id" class="input" data-variant-id>
                  {%- for variant in product.variants -%}
                    <option
                      value="{{ variant.id }}"
                      {% if variant == current_variant %}selected="selected"{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {{ variant.title | escape }} – {{ variant.price | money }}{% unless variant.available %} (épuisé){% endunless %}
                    </option>
                  {%- endfor -%}
                </select>
              </label>

              {%- if block.settings.show_quantity -%}
                <div class="qty">
                  <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                  <button type="button" class="qty__btn" data-qty-step="-1" aria-label="Diminuer la quantité">{% render 'icon', name: 'minus' %}</button>
                  <input id="Quantity-{{ section.id }}" class="qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                  <button type="button" class="qty__btn" data-qty-step="1" aria-label="Augmenter la quantité">{% render 'icon', name: 'plus' %}</button>
                </div>
              {%- endif -%}

              <button
                type="submit"
                name="add"
                class="button button--full product-form__submit"
                data-add-button
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span data-add-label>
                  {%- if current_variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
              </button>

              <p class="form-message form-message--error" role="alert" data-form-error hidden></p>

              {%- if block.settings.show_dynamic_checkout -%}
                {{ form | payment_button }}
              {%- endif -%}
            {%- endform -%}
            <form id="{{ form_id }}-options" hidden></form>
          </div>

        {%- when 'text' -%}
          <div class="rte product__text" {{ block.shopify_attributes }}>
            {%- if block.settings.use_description -%}
              {{ product.description }}
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </div>

        {%- when 'collapsible' -%}
          <details class="collapsible" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="collapsible__summary">
              {{ block.settings.heading | escape }}
              <span class="collapsible__icon" aria-hidden="true">{% render 'icon', name: 'plus' %}</span>
            </summary>
            <div class="collapsible__content rte">
              {%- if block.settings.use_description -%}
                {{ product.description }}
              {%- endif -%}
              {{ block.settings.content }}
              {%- if block.settings.page != blank -%}
                {{ block.settings.page.content }}
              {%- endif -%}
            </div>
          </details>

        {%- when 'share' -%}
          <p class="product__share" {{ block.shopify_attributes }}>
            <button type="button" class="link-btn" data-share data-share-url="{{ request.origin }}{{ product.url }}" data-share-title="{{ product.title | escape }}">
              {{ block.settings.label | escape }}
            </button>
          </p>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Fiche produit",
  "tag": "div",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Titre", "limit": 1 },
    { "type": "price", "name": "Prix", "limit": 1 },
    { "type": "variant_picker", "name": "Couleur et taille", "limit": 1 },
    {
      "type": "size_guide",
      "name": "Guide des tailles",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Texte du lien", "default": "Guide des tailles" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Bouton d'achat",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Sélecteur de quantité", "default": false },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Boutons de paiement rapide",
          "info": "Shop Pay, Apple Pay, etc. selon les moyens de paiement activés.",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [
        { "type": "checkbox", "id": "use_description", "label": "Utiliser la description du produit", "default": true },
        { "type": "richtext", "id": "text", "label": "Texte personnalisé" }
      ]
    },
    {
      "type": "collapsible",
      "name": "Onglet repliable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Entretien" },
        { "type": "checkbox", "id": "use_description", "label": "Afficher la description du produit", "default": false },
        { "type": "richtext", "id": "content", "label": "Contenu" },
        { "type": "page", "id": "page", "label": "Contenu d'une page (facultatif)" },
        { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false }
      ]
    },
    {
      "type": "share",
      "name": "Partager",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "Partager" }
      ]
    }
  ],
  "settings": []
}
{% endschema %}
