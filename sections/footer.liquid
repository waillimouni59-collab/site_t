{%- comment -%}
  Dans le texte « À propos », [marque] est remplacé par le nom de la boutique.
{%- endcomment -%}
<footer class="footer">
  <div class="footer__inner page-width">
    <div class="footer__col footer__about">
      <p class="footer__logo">{{ shop.name }}</p>
      {%- if section.settings.about != blank -%}
        <div class="rte footer__text">{{ section.settings.about | replace: '[marque]', shop.name }}</div>
      {%- endif -%}
    </div>

    <nav class="footer__col" aria-label="{{ section.settings.links_title | escape }}">
      <h2 class="footer__title">{{ section.settings.links_title | escape }}</h2>
      <ul class="footer__links" role="list">
        {%- assign footer_menu = section.settings.menu -%}
        {%- if footer_menu != blank and footer_menu.links.size > 0 -%}
          {%- for link in footer_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.root_url | append: '/pages/contact' | replace: '//', '/' }}">Contact</a></li>
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__title">{{ section.settings.social_title | escape }}</h2>
      <ul class="footer__social" role="list">
        {%- if settings.social_instagram != blank -%}
          <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}<span>Instagram</span></a></li>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">{% render 'icon', name: 'tiktok' %}<span>TikTok</span></a></li>
        {%- endif -%}
        {%- if settings.social_instagram == blank and settings.social_tiktok == blank and request.design_mode -%}
          <li class="footer__hint">Ajoutez vos liens dans Paramètres du thème &gt; Réseaux sociaux.</li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  <div class="footer__bottom page-width">
    <p class="footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    {%- if section.settings.show_localization -%}
      {% render 'localization-form', id: 'FooterLocalization' %}
    {%- endif -%}
    {%- if section.settings.show_payment_icons -%}
      <ul class="footer__payments" role="list" aria-label="Moyens de paiement acceptés">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "richtext",
      "id": "about",
      "label": "Texte de présentation",
      "info": "[marque] est remplacé par le nom de la boutique.",
      "default": "<p>[marque] — vêtements et essentiels du quotidien.</p>"
    },
    { "type": "text", "id": "links_title", "label": "Titre des liens", "default": "Informations" },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu des liens",
      "default": "footer",
      "info": "Conseillé : Contact, CGV, Mentions légales, Politique de confidentialité, Livraison et retours."
    },
    { "type": "text", "id": "social_title", "label": "Titre des réseaux", "default": "Suivez-nous" },
    { "type": "checkbox", "id": "show_localization", "label": "Sélecteur de devise", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Moyens de paiement", "default": true }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
