<section class="page-width contact" aria-label="Formulaire de contact">
  <div class="contact__paper">
    <span class="tape tape--tl"></span>
    <span class="tape tape--tr"></span>
    {%- if section.settings.title != blank -%}
      <h2 class="contact__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>Message bien reçu. On te répond vite (même le dimanche).</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label for="ContactName">Ton nom</label>
        <input class="input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="field">
        <label for="ContactEmail">Ton e-mail <span aria-hidden="true">*</span></label>
        <input class="input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
      </div>
      <div class="field">
        <label for="ContactBody">Ton message</label>
        <textarea class="input" id="ContactBody" name="contact[body]" rows="6">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="sticker-btn sticker-btn--red">Envoyer</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Formulaire de contact",
  "tag": "div",
  "class": "section-contact-form",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Écris-nous" }
  ],
  "presets": [{ "name": "Formulaire de contact" }]
}
{% endschema %}
