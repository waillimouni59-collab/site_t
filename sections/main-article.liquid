<article class="page-width article">
  <div class="narrow">
    <p class="article__date">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="page-title">{{ article.title | escape }}</h1>
  </div>
  {%- if article.image -%}
    <figure class="article__image">
      {{ article.image | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 1200px) 1100px, 100vw', alt: article.image.alt }}
    </figure>
  {%- endif -%}
  <div class="narrow">
    <div class="rte">{{ article.content }}</div>
    <p class="article__back"><a href="{{ blog.url }}" class="link-btn">← Retour au blog</a></p>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
