<article class="page-width article">
  <header class="article__head">
    <p class="article__date">{{ article.published_at | time_tag: format: 'date' }}</p>
    {% render 'pancarte-title', title: article.title, style: 'pancarte', tag: 'h1' %}
  </header>
  {%- if article.image -%}
    <figure class="article__image">
      {{ article.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 900px, 100vw', alt: article.image.alt }}
    </figure>
  {%- endif -%}
  <div class="rte article__body">{{ article.content }}</div>
  <p><a href="{{ blog.url }}" class="link-btn">← Retour au blog</a></p>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "div",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
