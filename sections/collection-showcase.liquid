{%- comment -%}
  Une section par collection (Pancartes, Stickers, Murs, Bitume).
  Le style change toute l'ambiance : carton, Y2K rose, mur taggé, affiche rouge et jaune.
{%- endcomment -%}
{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.products_to_show
  assign style = section.settings.style
  assign heading_id = 'Heading-' | append: section.id
  assign link = section.settings.link | default: coll.url
-%}

<section class="showcase showcase--{{ style }}" aria-labelledby="{{ heading_id }}">
  <div class="page-width">
    <div class="showcase__head{% if section.settings.image != blank %} showcase__head--with-image{% endif %}">
      <div class="showcase__copy">
        {%- if section.settings.kicker != blank -%}
          <p class="showcase__kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {% render 'pancarte-title', title: section.settings.title, style: style, id: heading_id %}
        {%- if section.settings.text != blank -%}
          <div class="showcase__intro rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.link_label != blank and link != blank -%}
          <a href="{{ link }}" class="showcase__link">
            {{- section.settings.link_label | escape }} {% render 'icon', name: 'arrow' -%}
            <span class="visually-hidden"> : {{ section.settings.title | escape }}</span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <figure class="showcase__poster reveal" style="--tilt: {{ section.settings.image_tilt }}deg;">
          <span class="tape tape--tl"></span>
          <span class="tape tape--br"></span>
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 990px) 30vw, 80vw',
              loading: 'lazy',
              alt: section.settings.image.alt
          }}
        </figure>
      {%- endif -%}
    </div>

    <div class="grid grid--products grid--cols-4">
      {%- if coll != blank and coll.products.size > 0 -%}
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {% render 'product-card', index: forloop.index0 %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection à thème",
  "tag": "div",
  "class": "section-showcase",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Ambiance",
      "options": [
        { "value": "pancarte", "label": "Pancartes : marqueur sur carton" },
        { "value": "sticker", "label": "Stickers : Y2K rose" },
        { "value": "mur", "label": "Murs : mur taggé" },
        { "value": "bitume", "label": "Bitume : affiche rouge et jaune" }
      ],
      "default": "pancarte"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "kicker", "label": "Petit texte au-dessus", "default": "Collection" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Pancartes" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Phrase d'intro",
      "default": "<p>Les slogans recopiés des pancartes de manif. Du carton, du marqueur, et beaucoup de choses à dire.</p>"
    },
    { "type": "text", "id": "link_label", "label": "Texte du lien", "default": "Tout voir" },
    { "type": "url", "id": "link", "label": "Lien", "info": "Par défaut : la collection choisie." },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Visuel d'ambiance (facultatif)",
      "info": "Affiché comme une affiche scotchée, par ex. le design original ou la photo du slogan trouvé."
    },
    {
      "type": "range",
      "id": "image_tilt",
      "label": "Rotation du visuel",
      "min": -4,
      "max": 4,
      "step": 1,
      "unit": "°",
      "default": 2
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Nombre de produits",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    { "name": "Collection : Pancartes", "settings": { "style": "pancarte", "title": "Pancartes" } },
    {
      "name": "Collection : Stickers",
      "settings": {
        "style": "sticker",
        "title": "Stickers",
        "text": "<p>Les autocollants trouvés sur les poteaux, entre deux arrêts de bus. Petit format, gros message.</p>"
      }
    },
    {
      "name": "Collection : Murs",
      "settings": {
        "style": "mur",
        "title": "Murs",
        "text": "<p>Tags et graffitis relevés sur les murs de la ville. On a juste changé de support.</p>"
      }
    },
    {
      "name": "Collection : Bitume",
      "settings": {
        "style": "bitume",
        "title": "Bitume",
        "text": "<p>Les messages peints au sol, en grand, pour que personne ne les rate. Rouge, jaune, et pas de demi-mesure.</p>"
      }
    }
  ]
}
{% endschema %}
