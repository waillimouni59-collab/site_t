{%- comment -%}
  Pages du compte client (comptes classiques) : connexion, inscription,
  mot de passe, compte, commande, adresses. Une seule section pour toutes.
{%- endcomment -%}
<section class="page-width customer">
  <div class="narrow">

    {%- case request.page_type -%}
      {%- when 'customers/login' -%}
        <h1 class="page-title">{{ 'Connexion' | escape }}</h1>
        <div id="RecoverPassword" class="customer__recover">
          <h2 class="customer__subtitle">Mot de passe oublié ?</h2>
          {%- form 'recover_customer_password' -%}
            {%- if form.posted_successfully? -%}
              <p class="form-message form-message--success" role="status">Un e-mail de réinitialisation vous a été envoyé.</p>
            {%- endif -%}
            {{ form.errors | default_errors }}
            <div class="field">
              <label for="RecoverEmail">E-mail</label>
              <input class="input" type="email" id="RecoverEmail" name="email" autocomplete="email" required>
            </div>
            <button type="submit" class="button button--outline">Réinitialiser</button>
            <a href="#Login" class="link-btn">Annuler</a>
          {%- endform -%}
        </div>

        <div id="Login">
          {%- form 'customer_login', novalidate: 'novalidate' -%}
            {{ form.errors | default_errors }}
            <div class="field">
              <label for="LoginEmail">E-mail</label>
              <input class="input" type="email" id="LoginEmail" name="customer[email]" autocomplete="email" required>
            </div>
            {%- if form.password_needed -%}
              <div class="field">
                <label for="LoginPassword">Mot de passe</label>
                <input class="input" type="password" id="LoginPassword" name="customer[password]" autocomplete="current-password" required>
              </div>
              <p><a href="#RecoverPassword" class="link-btn">Mot de passe oublié ?</a></p>
            {%- endif -%}
            <button type="submit" class="button">Se connecter</button>
          {%- endform -%}
          <p class="customer__alt">Pas encore de compte ? <a href="{{ routes.account_register_url }}">Créer un compte</a></p>
          {%- if shop.checkout.guest_login -%}
            {%- form 'guest_login' -%}
              <button type="submit" class="link-btn">Continuer en invité</button>
            {%- endform -%}
          {%- endif -%}
        </div>

      {%- when 'customers/register' -%}
        <h1 class="page-title">{{ 'Créer un compte' | escape }}</h1>
        {%- form 'create_customer', novalidate: 'novalidate' -%}
          {{ form.errors | default_errors }}
          <div class="field"><label for="RegFirst">Prénom</label><input class="input" type="text" id="RegFirst" name="customer[first_name]" autocomplete="given-name"></div>
          <div class="field"><label for="RegLast">Nom</label><input class="input" type="text" id="RegLast" name="customer[last_name]" autocomplete="family-name"></div>
          <div class="field"><label for="RegEmail">E-mail</label><input class="input" type="email" id="RegEmail" name="customer[email]" autocomplete="email" required></div>
          <div class="field"><label for="RegPassword">Mot de passe</label><input class="input" type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" required></div>
          <button type="submit" class="button">Créer mon compte</button>
        {%- endform -%}

      {%- when 'customers/activate_account' -%}
        <h1 class="page-title">{{ 'Activer votre compte' | escape }}</h1>
        {%- form 'activate_customer_password' -%}
          {{ form.errors | default_errors }}
          <div class="field"><label for="ActPassword">Mot de passe</label><input class="input" type="password" id="ActPassword" name="customer[password]" autocomplete="new-password" required></div>
          <div class="field"><label for="ActConfirm">Confirme le mot de passe</label><input class="input" type="password" id="ActConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
          <button type="submit" class="button">Activer</button>
          <button type="submit" name="decline" class="link-btn">Refuser l'invitation</button>
        {%- endform -%}

      {%- when 'customers/reset_password' -%}
        <h1 class="page-title">{{ 'Nouveau mot de passe' | escape }}</h1>
        {%- form 'reset_customer_password' -%}
          {{ form.errors | default_errors }}
          <div class="field"><label for="ResetPassword">Mot de passe</label><input class="input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required></div>
          <div class="field"><label for="ResetConfirm">Confirme le mot de passe</label><input class="input" type="password" id="ResetConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
          <button type="submit" class="button">Valider</button>
        {%- endform -%}

      {%- when 'customers/account' -%}
        <h1 class="page-title">{{ 'Mon compte' | escape }}</h1>
        <p>Bonjour {{ customer.first_name | default: customer.email | escape }}. <a href="{{ routes.account_logout_url }}" class="link-btn">Se déconnecter</a></p>
        <h2 class="customer__subtitle">Mes commandes</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="table-wrap">
              <table class="customer__table">
                <thead><tr><th scope="col">Commande</th><th scope="col">Date</th><th scope="col">Paiement</th><th scope="col">Livraison</th><th scope="col">Total</th></tr></thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <th scope="row"><a href="{{ order.customer_url }}">{{ order.name }}</a></th>
                      <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                      <td>{{ order.financial_status_label }}</td>
                      <td>{{ order.fulfillment_status_label }}</td>
                      <td>{{ order.total_net_amount | money }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          {%- else -%}
            <p>Vous n'avez pas encore passé de commande.</p>
          {%- endif -%}
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
        <h2 class="customer__subtitle">Mon adresse</h2>
        {%- if customer.default_address -%}
          <address>{{ customer.default_address | format_address }}</address>
        {%- endif -%}
        <p><a href="{{ routes.account_addresses_url }}" class="link-btn">Gérer mes adresses ({{ customer.addresses_count }})</a></p>

      {%- when 'customers/order' -%}
        <h1 class="page-title">{{ order.name | escape }}</h1>
        <p><a href="{{ routes.account_url }}" class="link-btn">← Retour au compte</a></p>
        <p>Passée le {{ order.created_at | time_tag: format: 'date' }}{% if order.cancelled %} — annulée ({{ order.cancel_reason_label }}){% endif %}</p>
        <div class="table-wrap">
          <table class="customer__table">
            <thead><tr><th scope="col">Produit</th><th scope="col">Prix</th><th scope="col">Quantité</th><th scope="col">Total</th></tr></thead>
            <tbody>
              {%- for line_item in order.line_items -%}
                <tr>
                  <th scope="row">{{ line_item.title | link_to: line_item.product.url }}</th>
                  <td>{{ line_item.final_price | money }}</td>
                  <td>{{ line_item.quantity }}</td>
                  <td>{{ line_item.final_line_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
            <tfoot>
              <tr><th scope="row" colspan="3">Sous-total</th><td>{{ order.line_items_subtotal_price | money }}</td></tr>
              {%- for shipping_method in order.shipping_methods -%}
                <tr><th scope="row" colspan="3">Livraison ({{ shipping_method.title | escape }})</th><td>{{ shipping_method.price | money }}</td></tr>
              {%- endfor -%}
              <tr><th scope="row" colspan="3">Total</th><td>{{ order.total_net_amount | money }}</td></tr>
            </tfoot>
          </table>
        </div>
        {%- if order.shipping_address -%}
          <h2 class="customer__subtitle">Adresse de livraison</h2>
          <address>{{ order.shipping_address | format_address }}</address>
        {%- endif -%}

      {%- when 'customers/addresses' -%}
        <h1 class="page-title">{{ 'Mes adresses' | escape }}</h1>
        <p><a href="{{ routes.account_url }}" class="link-btn">← Retour au compte</a></p>
        {%- paginate customer.addresses by 10 -%}
          {%- for address in customer.addresses -%}
            <div class="customer__address">
              <address>{{ address | format_address }}</address>
              {%- if address == customer.default_address %}<p class="badge badge--static">Par défaut</p>{% endif -%}
              <details>
                <summary class="link-btn">Modifier</summary>
                {%- form 'customer_address', address -%}
                  {% render 'address-fields', form: form, id: address.id %}
                  <button type="submit" class="button button--outline">Enregistrer</button>
                {%- endform -%}
              </details>
              <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}">
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="link-btn">Supprimer</button>
              </form>
            </div>
          {%- endfor -%}
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
        <details class="customer__new-address">
          <summary class="button button--outline">Ajouter une adresse</summary>
          {%- form 'customer_address', customer.new_address -%}
            {% render 'address-fields', form: form, id: 'new' %}
            <button type="submit" class="button">Ajouter</button>
          {%- endform -%}
        </details>
    {%- endcase -%}
  </div>
</section>

{% schema %}
{
  "name": "Compte client",
  "tag": "div",
  "class": "section-main-customer",
  "settings": []
}
{% endschema %}
