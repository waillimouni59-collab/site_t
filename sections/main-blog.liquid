{%- paginate blog.articles by 12 -%}
  <section class="page-width blog">
    <h1 class="page-title">{{ blog.title | escape }}</h1>
    <ul class="blog__grid" role="list">
      {%- for article in blog.articles -%}
        <li class="blog-card reveal">
          <a href="{{ article.url }}" class="blog-card__link">
            {%- if article.image -%}
              <span class="blog-card__media">
                {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt }}
              </span>
            {%- endif -%}
            <p class="blog-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
            <h2 class="blog-card__title">{{ article.title | escape }}</h2>
            <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "tag": "div",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
