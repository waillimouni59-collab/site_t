{%- paginate blog.articles by 12 -%}
  <section class="page-width blog">
    {% render 'pancarte-title', title: blog.title, style: 'pancarte', tag: 'h1' %}
    <ul class="blog__grid" role="list">
      {%- for article in blog.articles -%}
        <li class="blog-card reveal" style="--tilt: {% cycle '-1deg', '1deg', '0deg' %};">
          <a href="{{ article.url }}" class="blog-card__link">
            {%- if article.image -%}
              {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt }}
            {%- endif -%}
            <h2 class="blog-card__title">{{ article.title | escape }}</h2>
            <p class="blog-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "tag": "div",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
