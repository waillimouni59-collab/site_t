<section class="reassurance" aria-label="{{ section.settings.label | escape }}">
  <div class="page-width">
    <ul class="reassurance__list" role="list">
      {%- for block in section.blocks -%}
        <li class="reassurance__item" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <div>
            <h3 class="reassurance__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="reassurance__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Services",
  "tag": "div",
  "class": "section-reassurance",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "label", "label": "Titre (lecteurs d'écran)", "default": "Nos services" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Service",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "truck", "label": "Livraison" },
            { "value": "return", "label": "Retour" },
            { "value": "lock", "label": "Paiement" },
            { "value": "chat", "label": "Contact" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Livraison offerte dès 60 €" },
        { "type": "text", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Livraison offerte dès 60 €", "text": "Expédition rapide partout en France." } },
        { "type": "item", "settings": { "icon": "return", "title": "Retours sous 30 jours", "text": "Échange ou remboursement, simplement." } },
        { "type": "item", "settings": { "icon": "lock", "title": "Paiement sécurisé", "text": "Vos données sont protégées." } }
      ]
    }
  ]
}
{% endschema %}
