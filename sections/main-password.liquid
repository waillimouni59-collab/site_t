<section class="password showcase showcase--bitume">
  <div class="page-width password__inner">
    <p class="header__logo-text password__logo">{{ shop.name }}</p>
    <h1 class="hero__title">{{ section.settings.title | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message | escape }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelancement">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">C'est noté. Tu seras dans les premiers au courant.</p>
      {%- else -%}
        <div class="newsletter__field">
          <label class="visually-hidden" for="PasswordNewsletter">Ton e-mail</label>
          <input id="PasswordNewsletter" class="input" type="email" name="contact[email]" placeholder="ton@email.fr" autocomplete="email" required>
          <button type="submit" class="sticker-btn sticker-btn--yellow">Préviens-moi</button>
        </div>
        {{ form.errors | default_errors }}
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="link-btn">Entrer avec le mot de passe</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div class="newsletter__field">
          <label class="visually-hidden" for="StorePassword">Mot de passe</label>
          <input id="StorePassword" class="input" type="password" name="password" autocomplete="current-password" placeholder="Mot de passe">
          <button type="submit" class="sticker-btn">Entrer</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "tag": "div",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "On prépare quelque chose." }
  ]
}
{% endschema %}
