<section class="page-width list-collections">
  <h1 class="page-title">{{ section.settings.title | escape }}</h1>
  <ul class="collection-list collection-list--3" role="list">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <li class="collection-list__item reveal">
          <a href="{{ collection.url }}" class="collection-tile">
            <span class="collection-tile__media">
              {%- assign tile_image = collection.featured_image | default: collection.products.first.featured_media.preview_image -%}
              {%- if tile_image != blank -%}
                {{ tile_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 990px) 33vw, 100vw', alt: '' }}
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </span>
            <span class="collection-tile__title">{{ collection.title | escape }}</span>
          </a>
        </li>
      {%- endunless -%}
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Liste des collections",
  "tag": "div",
  "class": "section-list-collections",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Collections" }
  ]
}
{% endschema %}
