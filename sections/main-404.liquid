<section class="page-width not-found">
  <p class="not-found__code" aria-hidden="true">404</p>
  {% render 'pancarte-title', title: section.settings.title, style: 'mur', tag: 'h1' %}
  <div class="rte">{{ section.settings.text }}</div>
  <a href="{{ routes.all_products_collection_url }}" class="sticker-btn sticker-btn--yellow sticker-btn--large">{{ section.settings.button_label | escape }}</a>
</section>

{% schema %}
{
  "name": "Page introuvable",
  "tag": "div",
  "class": "section-main-404",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Cette page a été décollée." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Comme un sticker un peu trop exposé, cette page n'est plus là. Les t-shirts, eux, n'ont pas bougé.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Voir les t-shirts" }
  ]
}
{% endschema %}
