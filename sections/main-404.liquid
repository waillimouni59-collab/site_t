<section class="page-width not-found">
  <p class="not-found__code">404</p>
  <h1 class="page-title">{{ section.settings.title | escape }}</h1>
  <div class="rte">{{ section.settings.text }}</div>
  <a href="{{ routes.all_products_collection_url }}" class="button">{{ section.settings.button_label | escape }}</a>
</section>

{% schema %}
{
  "name": "Page introuvable",
  "tag": "div",
  "class": "section-main-404",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Page introuvable" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>La page que vous cherchez n'existe pas ou a été déplacée.</p>" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Continuer les achats" }
  ]
}
{% endschema %}
