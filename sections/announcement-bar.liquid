{%- comment -%}
  Bandeau défilant. Le contenu est dupliqué pour une boucle continue ;
  la copie est masquée aux lecteurs d'écran.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div
    class="marquee marquee--{{ section.settings.background }}"
    style="--marquee-duration: {{ section.settings.speed }}s;"
    role="region"
    aria-label="Annonces"
    {{ section.shopify_attributes }}
  >
    <div class="marquee__track">
      {%- for i in (1..2) -%}
        <ul class="marquee__list"{% if i == 2 %} aria-hidden="true"{% endif %}>
          {%- for n in (1..3) -%}
            {%- for block in section.blocks -%}
              <li class="marquee__item"{% if i == 1 and n == 1 %} {{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}"{% if i == 2 or n > 1 %} tabindex="-1"{% endif %}>{{ block.settings.text | escape }}</a>
                {%- else -%}
                  {{ block.settings.text | escape }}
                {%- endif -%}
              </li>
              <li class="marquee__sep" aria-hidden="true">•</li>
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau défilant",
  "class": "section-announcement",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Couleur de fond",
      "options": [
        { "value": "red", "label": "Rouge / texte blanc" },
        { "value": "ink", "label": "Noir / texte blanc" },
        { "value": "yellow", "label": "Jaune / texte noir" }
      ],
      "default": "red"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Durée d'un tour",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Porte tes idées" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau défilant",
      "blocks": [
        { "type": "message", "settings": { "text": "Livraison offerte dès 60 €" } },
        { "type": "message", "settings": { "text": "3 t-shirts achetés = le 4e offert" } },
        { "type": "message", "settings": { "text": "Porte tes idées" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
