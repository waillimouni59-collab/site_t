{%- comment -%}
  Bandeau d'annonce sobre. Plusieurs messages défilent en fondu.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div
    class="announcement"
    role="region"
    aria-label="Annonces"
    data-announcement
    data-speed="{{ section.settings.autoplay_speed }}"
  >
    <div class="announcement__inner page-width">
      {%- for block in section.blocks -%}
        <p class="announcement__message{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }} {% unless forloop.first %}aria-hidden="true"{% endunless %}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d'annonce",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Changement de message toutes les",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte en France dès 60 €" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau d'annonce",
      "blocks": [{ "type": "message" }]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
