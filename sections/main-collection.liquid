{%- comment -%}
  Page collection : titre, filtres (couleur, taille, prix), tri et grille.
  Les filtres viennent de Shopify (app gratuite « Search & Discovery »).
{%- endcomment -%}
{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}

<div class="collection" data-collection-section data-section-id="{{ section.id }}">
  <header class="collection__head page-width">
    <h1 class="page-title">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank and section.settings.show_description -%}
      <div class="rte collection__description">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.per_page -%}
    <div class="page-width collection__body">
      <form class="filters" action="{{ collection.url }}" method="get" data-filters-form>
        <div class="filters__bar">
          <p class="filters__count" role="status">
            {{ collection.products_count }} article{% if collection.products_count > 1 %}s{% endif %}
          </p>

          {%- if section.settings.enable_filters and collection.filters.size > 0 -%}
            <div class="filters__list">
              {%- for filter in collection.filters -%}
                <details class="filter" data-filter>
                  <summary class="filter__summary">
                    {{ filter.label | escape }}
                    {%- if filter.active_values.size > 0 %} <span class="filter__badge">{{ filter.active_values.size }}</span>{% endif -%}
                    {%- if filter.type == 'price_range' -%}
                      {%- if filter.min_value.value or filter.max_value.value %} <span class="filter__badge">1</span>{% endif -%}
                    {%- endif -%}
                  </summary>
                  <div class="filter__panel">
                    {%- case filter.type -%}
                      {%- when 'list', 'boolean' -%}
                        <fieldset>
                          <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                          <ul class="filter__values" role="list">
                            {%- for value in filter.values -%}
                              {%- assign filter_label = filter.label | downcase -%}
                              <li>
                                <label class="filter__option{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                                  <input
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    {% if value.active %}checked{% endif %}
                                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                  >
                                  {%- if filter_label == 'couleur' or filter_label == 'color' -%}
                                    <span class="swatch swatch--small" style="--swatch: {% render 'color-value', value: value.label %};" aria-hidden="true"></span>
                                  {%- endif -%}
                                  <span>{{ value.label | escape }}</span>
                                  <span class="filter__n">({{ value.count }})</span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </fieldset>
                      {%- when 'price_range' -%}
                        <div class="filter__price">
                          <label>
                            <span>De</span>
                            <input
                              class="input"
                              type="number"
                              name="{{ filter.min_value.param_name }}"
                              {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '.' }}"{% endif %}
                              placeholder="0"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | replace: ',', '.' }}"
                              step="1"
                            >
                          </label>
                          <label>
                            <span>à</span>
                            <input
                              class="input"
                              type="number"
                              name="{{ filter.max_value.param_name }}"
                              {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '.' }}"{% endif %}
                              placeholder="{{ filter.range_max | money_without_currency | replace: ',', '.' }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | replace: ',', '.' }}"
                              step="1"
                            >
                          </label>
                          <span>{{ cart.currency.symbol }}</span>
                        </div>
                    {%- endcase -%}
                  </div>
                </details>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if section.settings.enable_sorting -%}
            <label class="filters__sort">
              <span>Trier</span>
              <select name="sort_by" class="input" data-auto-submit>
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected="selected"{% endif %}>
                    {{ option.name | escape }}
                  </option>
                {%- endfor -%}
              </select>
            </label>
          {%- endif -%}

          <noscript><button type="submit" class="button button--small">Filtrer</button></noscript>
        </div>

        {%- liquid
          assign has_active = false
          for filter in collection.filters
            if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
              assign has_active = true
            endif
          endfor
        -%}
        {%- if has_active -%}
          <ul class="filters__active" role="list">
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <li>
                  <a class="chip" href="{{ value.url_to_remove }}">
                    {{ value.label | escape }} <span aria-hidden="true">×</span><span class="visually-hidden">Retirer le filtre</span>
                  </a>
                </li>
              {%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value or filter.max_value.value -%}
                  <li>
                    <a class="chip" href="{{ filter.url_to_remove }}">
                      {{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}
                      <span aria-hidden="true">×</span><span class="visually-hidden">Retirer le filtre</span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <li><a class="chip chip--clear" href="{{ collection.url }}?sort_by={{ sort_by }}">Tout effacer</a></li>
          </ul>
        {%- endif -%}
      </form>

      {%- if collection.products.size > 0 -%}
        <div class="grid grid--products grid--cols-{{ section.settings.columns_desktop }}" id="ProductGrid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product, index: forloop.index0 %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="empty-state">
          <p class="empty-state__title">Aucun produit trouvé</p>
          <p>Aucun article ne correspond à ces filtres.</p>
          <a href="{{ collection.url }}" class="button button--outline">Effacer les filtres</a>
        </div>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    { "type": "checkbox", "id": "show_description", "label": "Afficher la description de la collection", "default": true },
    {
      "type": "range",
      "id": "per_page",
      "label": "Produits par page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Colonnes sur ordinateur",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    { "type": "checkbox", "id": "enable_filters", "label": "Filtres", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Tri", "default": true }
  ]
}
{% endschema %}
