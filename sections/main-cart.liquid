<section class="page-width cart-page" data-cart-page data-section-id="{{ section.id }}">
  <h1 class="page-title">{{ section.settings.title | escape }}</h1>
  <div data-drawer-content>
    {% render 'cart-contents', context: 'page' %}
  </div>
</section>

{% schema %}
{
  "name": "Panier",
  "tag": "div",
  "class": "section-main-cart",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Panier" }
  ]
}
{% endschema %}
