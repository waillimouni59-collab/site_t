{%- comment -%}
  Page « Le manifeste » mise en page comme un fanzine :
  photocopie, collage, gros titres, citations scotchées, stickers.
  Chaque morceau est un bloc réglable dans l'éditeur.
{%- endcomment -%}
<article class="zine">
  <header class="zine__cover">
    <div class="page-width">
      <p class="zine__issue">{{ section.settings.issue | escape }}</p>
      <h1 class="zine__title">{{ section.settings.title | escape | newline_to_br }}</h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="zine__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>
  </header>

  <div class="page-width zine__pages">
    {%- for block in section.blocks -%}
      {%- assign tilt = block.settings.tilt | default: 0 -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="zine__heading zine__heading--{{ block.settings.style }} zine--{{ block.settings.width }} reveal" style="--tilt: {{ tilt }}deg;" {{ block.shopify_attributes }}>
            {%- if block.settings.style == 'ransom' -%}
              {%- comment -%} Lettres « découpées dans des magazines » : une étiquette par mot, lisible par les lecteurs d'écran. {%- endcomment -%}
              {%- assign words = block.settings.text | split: ' ' -%}
              {%- for word in words -%}
                <span class="ransom ransom--{% cycle 'a', 'b', 'c', 'd', 'e' %}">{{ word | escape }}</span>{% unless forloop.last %} {% endunless %}
              {%- endfor -%}
            {%- else -%}
              {{- block.settings.text | escape -}}
            {%- endif -%}
          </h2>

        {%- when 'paragraph' -%}
          <div class="zine__text zine__text--{{ block.settings.paper }} zine--{{ block.settings.width }} rte reveal" style="--tilt: {{ tilt }}deg;" {{ block.shopify_attributes }}>
            {%- if block.settings.paper != 'none' -%}<span class="tape tape--tl"></span>{%- endif -%}
            {{ block.settings.text }}
          </div>

        {%- when 'quote' -%}
          <figure class="zine__quote zine__quote--{{ block.settings.color }} zine--{{ block.settings.width }} reveal" style="--tilt: {{ tilt }}deg;" {{ block.shopify_attributes }}>
            <span class="tape tape--tl"></span>
            <span class="tape tape--tr"></span>
            <blockquote>{{ block.settings.text | escape | newline_to_br }}</blockquote>
            {%- if block.settings.source != blank -%}
              <figcaption>— {{ block.settings.source | escape }}</figcaption>
            {%- endif -%}
          </figure>

        {%- when 'image' -%}
          <figure class="zine__image zine--{{ block.settings.width }} reveal" style="--tilt: {{ tilt }}deg;" {{ block.shopify_attributes }}>
            <span class="tape tape--tl"></span>
            <span class="tape tape--br"></span>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  widths: '400, 700, 1000, 1400',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <figcaption>{{ block.settings.caption | escape }}</figcaption>
            {%- endif -%}
          </figure>

        {%- when 'sticker' -%}
          <p class="zine__sticker zine__sticker--{{ block.settings.color }} reveal" style="--tilt: {{ tilt }}deg;" {{ block.shopify_attributes }}>
            {{- block.settings.text | escape -}}
          </p>

        {%- when 'tape' -%}
          <div class="zine--full" {{ block.shopify_attributes }}>
            {% render 'rubalise', text: block.settings.text, tilt: tilt %}
          </div>

        {%- when 'page_content' -%}
          {%- if page.content != blank -%}
            <div class="zine__text zine__text--paper zine--full rte" {{ block.shopify_attributes }}>
              {{ page.content }}
            </div>
          {%- endif -%}

        {%- when 'button' -%}
          <p class="zine__cta zine--full" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="sticker-btn sticker-btn--large sticker-btn--{{ block.settings.color }}">
              {{- block.settings.label | escape -}}
            </a>
          </p>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</article>

{% schema %}
{
  "name": "Manifeste (fanzine)",
  "tag": "div",
  "class": "section-main-manifeste",
  "settings": [
    { "type": "text", "id": "issue", "label": "Numéro", "default": "Fanzine n°1 — gratuit, à photocopier" },
    { "type": "textarea", "id": "title", "label": "Titre", "default": "Le manifeste" },
    { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Pourquoi on écrit sur des t-shirts ce que d'autres écrivent sur des murs." }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Titre",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Porte tes idées." },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "condensed", "label": "Grosse police condensée" },
            { "value": "marker", "label": "Marqueur" },
            { "value": "ransom", "label": "Lettres découpées" },
            { "value": "red", "label": "Bandeau rouge" }
          ],
          "default": "condensed"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Largeur",
          "options": [
            { "value": "full", "label": "Pleine largeur" },
            { "value": "left", "label": "Colonne gauche" },
            { "value": "right", "label": "Colonne droite" }
          ],
          "default": "full"
        },
        { "type": "range", "id": "tilt", "label": "Rotation", "min": -4, "max": 4, "step": 1, "unit": "°", "default": 0 }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragraphe",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Écris ici.</p>" },
        {
          "type": "select",
          "id": "paper",
          "label": "Support",
          "options": [
            { "value": "none", "label": "Aucun" },
            { "value": "paper", "label": "Feuille photocopiée" },
            { "value": "kraft", "label": "Carton kraft" },
            { "value": "ink", "label": "Fond noir" }
          ],
          "default": "paper"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Largeur",
          "options": [
            { "value": "full", "label": "Pleine largeur" },
            { "value": "left", "label": "Colonne gauche" },
            { "value": "right", "label": "Colonne droite" }
          ],
          "default": "left"
        },
        { "type": "range", "id": "tilt", "label": "Rotation", "min": -4, "max": 4, "step": 1, "unit": "°", "default": 0 }
      ]
    },
    {
      "type": "quote",
      "name": "Citation scotchée",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Citation", "default": "On ne lâche rien." },
        { "type": "text", "id": "source", "label": "Source", "default": "Pancarte, place de la République" },
        {
          "type": "select",
          "id": "color",
          "label": "Couleur",
          "options": [
            { "value": "yellow", "label": "Jaune" },
            { "value": "pink", "label": "Rose" },
            { "value": "sky", "label": "Bleu ciel" },
            { "value": "red", "label": "Rouge" },
            { "value": "kraft", "label": "Kraft" }
          ],
          "default": "yellow"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Largeur",
          "options": [
            { "value": "full", "label": "Pleine largeur" },
            { "value": "left", "label": "Colonne gauche" },
            { "value": "right", "label": "Colonne droite" }
          ],
          "default": "right"
        },
        { "type": "range", "id": "tilt", "label": "Rotation", "min": -4, "max": 4, "step": 1, "unit": "°", "default": 2 }
      ]
    },
    {
      "type": "image",
      "name": "Image collée",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Légende" },
        {
          "type": "select",
          "id": "width",
          "label": "Largeur",
          "options": [
            { "value": "full", "label": "Pleine largeur" },
            { "value": "left", "label": "Colonne gauche" },
            { "value": "right", "label": "Colonne droite" }
          ],
          "default": "right"
        },
        { "type": "range", "id": "tilt", "label": "Rotation", "min": -4, "max": 4, "step": 1, "unit": "°", "default": -2 }
      ]
    },
    {
      "type": "sticker",
      "name": "Sticker",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Colle-moi partout" },
        {
          "type": "select",
          "id": "color",
          "label": "Couleur",
          "options": [
            { "value": "yellow", "label": "Jaune" },
            { "value": "pink", "label": "Rose" },
            { "value": "sky", "label": "Bleu ciel" },
            { "value": "red", "label": "Rouge" }
          ],
          "default": "pink"
        },
        { "type": "range", "id": "tilt", "label": "Rotation", "min": -8, "max": 8, "step": 1, "unit": "°", "default": -4 }
      ]
    },
    {
      "type": "tape",
      "name": "Rubalise",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Porte tes idées" },
        { "type": "range", "id": "tilt", "label": "Rotation", "min": -4, "max": 4, "step": 1, "unit": "°", "default": -1 }
      ]
    },
    {
      "type": "page_content",
      "name": "Contenu de la page",
      "limit": 1
    },
    {
      "type": "button",
      "name": "Bouton",
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "Voir les t-shirts" },
        { "type": "url", "id": "link", "label": "Lien" },
        {
          "type": "select",
          "id": "color",
          "label": "Couleur",
          "options": [
            { "value": "red", "label": "Rouge" },
            { "value": "yellow", "label": "Jaune" },
            { "value": "pink", "label": "Rose" }
          ],
          "default": "red"
        }
      ]
    }
  ],
  "presets": [{ "name": "Manifeste (fanzine)" }]
}
{% endschema %}
