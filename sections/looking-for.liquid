{%- assign heading_id = 'Heading-' | append: section.id -%}
<section class="section looking-for" aria-labelledby="{{ heading_id }}">
  <div class="page-width looking-for__inner">
    {% render 'pancarte-title', title: section.settings.title, style: 'sticker', id: heading_id %}
    <div class="looking-for__answer reveal">
      <span class="tape tape--tl"></span>
      <div class="rte">{{ section.settings.text }}</div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="looking-for__buttons" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="sticker-btn sticker-btn--large sticker-btn--{{ block.settings.style }}" style="--tilt: {% cycle '-2deg', '1.5deg', '-1deg' %};">
              {{- block.settings.label | escape -}}
              {%- if block.settings.badge != blank -%}
                <span class="sticker-btn__badge">{{ block.settings.badge | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Tu cherches quoi ?",
  "tag": "div",
  "class": "section-looking-for",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Tu cherches quoi ?" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Réponse",
      "default": "<p>Surtout des t-shirts. Des hoodies arrivent bientôt. Pas encore de pancartes en carton, mais on y réfléchit.</p>"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Bouton",
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "T-shirts" },
        { "type": "url", "id": "link", "label": "Lien" },
        { "type": "text", "id": "badge", "label": "Pastille (facultatif)", "info": "Ex. « Bientôt »" },
        {
          "type": "select",
          "id": "style",
          "label": "Couleur",
          "options": [
            { "value": "yellow", "label": "Jaune" },
            { "value": "red", "label": "Rouge" },
            { "value": "pink", "label": "Rose" },
            { "value": "sky", "label": "Bleu ciel" },
            { "value": "paper", "label": "Blanc" }
          ],
          "default": "yellow"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tu cherches quoi ?",
      "blocks": [
        { "type": "button", "settings": { "label": "T-shirts", "style": "yellow" } },
        { "type": "button", "settings": { "label": "Hoodies", "style": "sky", "badge": "Bientôt" } }
      ]
    }
  ]
}
{% endschema %}
