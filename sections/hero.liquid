{%- liquid
  assign img = section.settings.image
  assign img_mobile = section.settings.image_mobile | default: img
  assign heading_id = 'HeroTitle-' | append: section.id
-%}

<section
  class="hero hero--{{ section.settings.height }} hero--{{ section.settings.align }}{% if img == blank %} hero--placeholder{% endif %}"
  style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
  {% if section.settings.title != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  <div class="hero__media">
    {%- if img != blank -%}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ img_mobile | image_url: width: 750 }} 750w, {{ img_mobile | image_url: width: 1100 }} 1100w"
          sizes="100vw"
        >
        {{
          img
          | image_url: width: 2800
          | image_tag:
            class: 'hero__img',
            widths: '1100, 1500, 1800, 2400, 2800',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: img.alt
        }}
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__img placeholder' }}
    {%- endif -%}
  </div>

  {%- if section.settings.title != blank or section.settings.button_label != blank -%}
    <div class="hero__content page-width">
      {%- if section.settings.title != blank -%}
        <h2 id="{{ heading_id }}" class="hero__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--{{ section.settings.button_style }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Bannière image",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "2800 × 1400 px conseillé." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image mobile (facultatif)" },
    {
      "type": "select",
      "id": "height",
      "label": "Hauteur",
      "options": [
        { "value": "full", "label": "Plein écran" },
        { "value": "large", "label": "Grande" },
        { "value": "medium", "label": "Moyenne" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Position du texte",
      "options": [
        { "value": "bottom-left", "label": "En bas à gauche" },
        { "value": "center", "label": "Centré" },
        { "value": "bottom-center", "label": "En bas au centre" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Assombrir l'image",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nouvelle collection" },
    { "type": "text", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Découvrir" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style du bouton",
      "options": [
        { "value": "light", "label": "Blanc" },
        { "value": "dark", "label": "Noir" },
        { "value": "outline-light", "label": "Contour blanc" }
      ],
      "default": "light"
    }
  ],
  "presets": [{ "name": "Bannière image" }]
}
{% endschema %}
